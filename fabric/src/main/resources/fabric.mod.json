{
  "schemaVersion": 1,
  "id": "combatsync",
  "version": "${version}",
  "name": "Combat Sync",
  "description": "Client-side combat responsiveness for crystals, anchors, pearls, eating visuals, and rejected block actions with an in-game settings menu.",
  "authors": ["Cayden Hatch"],
  "license": "CC0-1.0",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.caydenhatch.combatsync.CombatSyncClient"]
  },
  "mixins": [
    {
      "config": "combatsync.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
